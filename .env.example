# WebSocket server bind address
ORACLE_BIND_ADDR=0.0.0.0:8083

# Log level (debug, info, warn, error)
RUST_LOG=info

# Block Scholes API key (required). Sent in the JSON-RPC authenticate call.
BLOCKSCHOLES_API_KEY=

# Optional: index.px subscription frequency in ms, 1 to 1000 (the TWAP samples
# once per second). Slower or malformed values fail startup. Faster values must
# also be allowed by the account's plan, which today means only 1000.
# BLOCKSCHOLES_FREQUENCY_MS=1000
